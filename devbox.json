{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "go@latest",
    "gopls@latest",
    "golangci-lint@latest"
  ],
  "shell": {
    "scripts": {
      "build": "go build ./...",
      "test": "go test ./...",
      "tidy": "go mod tidy",
      "lint": "golangci-lint run",
      "run": "go run .",
      "vet": "go vet ./..."
    }
  }
}
